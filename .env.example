# Provisioned automatically by Lovable Cloud — do not commit real values.
#
# These three are the only variables the dashboard needs. On Vercel add them as
# Environment Variables (Production + Preview) with the values from this project's
# Lovable Cloud backend, then redeploy — Vite inlines VITE_* at build time, so a
# rebuild is required after changing them.
VITE_SUPABASE_URL=your-backend-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Optional server-side aliases (same values). Useful if a host injects only
# non-prefixed names; the analytics client accepts either set.
# SUPABASE_URL=your-backend-url
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
